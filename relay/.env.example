# dlp-server gRPC 주소 (host:port)
DLP_SERVER_ADDR=localhost:50051

# 프록시 호출 deadline과 동일 기준 (아키텍처 §2.4)
GRPC_DEADLINE_SECONDS=3.0

# dlp-server 무응답/오류 시 정책. true=block(기본), false=allow(시연 안정용)
FAIL_CLOSED=true

# 전송 모드: direct (Relay가 dlp-server/LLM 직접 호출) | dlp_proxy (dlp-proxy 경유)
TRANSPORT_MODE=direct

# dlp_proxy 모드에서만 사용
DLP_PROXY_HOST=localhost
DLP_PROXY_PORT=8443
# dlp-proxy-server의 certs/ca.pem 절대경로 (예: C:\Dev\genai-dlp\dlp-proxy-server\certs\ca.pem)
DLP_PROXY_CA_CERT=
GEMINI_UPSTREAM_HOST=generativelanguage.googleapis.com

# LLM 호출 대상: openai | gemini (direct 모드에서만 의미 있음)
LLM_PROVIDER=gemini

# OpenAI (LLM_PROVIDER=openai일 때 사용)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini — 무료 티어 키는 https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

PORT=8080
