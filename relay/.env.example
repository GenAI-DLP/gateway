# dlp-server gRPC 주소 (host:port)
DLP_SERVER_ADDR=localhost:50051

# 프록시 호출 deadline과 동일 기준 (아키텍처 §2.4)
GRPC_DEADLINE_SECONDS=3.0

# dlp-server 무응답/오류 시 정책. true=block(기본), false=allow(시연 안정용)
FAIL_CLOSED=true

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=여기에_발급받은_키
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

PORT=8080
DLP_SERVER_ADDR=localhost:50051
